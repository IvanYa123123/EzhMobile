
# ============================================================

# EzhMobile — .gitignore

# ============================================================

# ---------- Скачиваемые сторонние ассеты интерфейса ----------
# Качаются node scripts/fetch_vendor_assets.mjs (в CI — перед сборкой APK).

EzhAndroid/app/src/main/assets/static/vendor/
EzhAndroid/app/src/main/assets/static/fonts/*.woff2

# ---------- Android / Gradle ----------

.gradle/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Android Studio / IDEA

.idea/
*.iml
*.ipr
*.iws
*.hprof

# Подписные ключи и keystore — никогда не коммитить

*.jks
*.keystore
*.p12
keystore.properties
signing.properties
*.jks.b64
*.keystore.b64

# Скомпилированные APK/AAB

*.apk
*.aab
*.ap_
*.dex
*.class

# ---------- Node (на случай появления тулинга) ----------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Логи ----------

*.log
logs/

# ---------- Env ----------

.env
.env.*
!.env.example

# ---------- OS ----------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.Trash-*

# ---------- IDE ----------

.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ---------- Прочее ----------

*.bak
*.tmp
*.orig
*.rej
