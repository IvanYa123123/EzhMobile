
# ============================================================

# EzhMobile — .gitignore

# ============================================================

# ---------- Python ----------

**pycache**/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Виртуальные окружения

.venv/
venv/
ENV/
env/
.python-version

# Тесты / покрытие

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- Flask / runtime ----------

# База данных и её WAL/SHM — создаются при первом запуске

EzhAndroid/app/src/main/python/planner.db
EzhAndroid/app/src/main/python/planner.db-wal
EzhAndroid/app/src/main/python/planner.db-shm

# Кэш расписаний, скачиваемый с сервера СевГУ во время работы

EzhAndroid/app/src/main/python/schedules/
EzhAndroid/app/src/main/python/teacher_schedules/

# Пользовательские данные, генерируемые на устройстве

EzhAndroid/app/src/main/python/custom_groups.json
EzhAndroid/app/src/main/python/.sync_times.json

# Скачиваемые сторонние ассеты интерфейса (scripts/fetch_vendor_assets.py)

EzhAndroid/app/src/main/python/static/vendor/
EzhAndroid/app/src/main/python/static/fonts/*.woff2

# ---------- Android / Gradle ----------

.gradle/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Android Studio / IDEA

.idea/
*.iml
*.ipr
*.iws
*.hprof

# Подписные ключи и keystore — никогда не коммитить

*.jks
*.keystore
*.p12
keystore.properties
signing.properties
*.jks.b64
*.keystore.b64

# Скомпилированные APK/AAB

*.apk
*.aab
*.ap_
*.dex
*.class

# ---------- Chaquopy ----------

# Собранные нативные библиотеки Python — пересоздаются при сборке

EzhAndroid/app/src/main/python/.chaquopy/

# ---------- Node (на случай появления тулинга) ----------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Логи ----------

*.log
logs/

# ---------- Env ----------

.env
.env.*
!.env.example

# ---------- OS ----------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.Trash-*

